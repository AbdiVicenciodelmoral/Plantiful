<!-- Tells the browser this document uses modern HTML5 -->
<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Sets the character encoding so text displays correctly -->
  <meta charset="UTF-8" />

  <!-- Sets the browser tab title -->
  <title>Dashboard | Plantiful</title>

  <!-- Loads the shared CSS file from the public folder -->
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <!-- Site navigation for logged-in users -->
  <nav class="navbar">
    <div class="logo">Plantiful</div>

    <div class="nav-links">
      <a href="/">Home</a>

      <!-- Logout is a form because it changes the user's session state. -->
      <form action="/logout" method="POST" class="nav-form">
        <button type="submit" class="link-button">Logout</button>
      </form>
    </div>
  </nav>

  <!-- Protected dashboard content -->
  <main class="dashboard">
    <section>
      <!-- <%= %> prints escaped server-side data into the HTML. -->
      <h1>Welcome, <%= user.username %></h1>
      <p>You reached this page because the server found a session cookie.</p>
    </section>

    <section class="secret-box">
      <h2>Account Details</h2>

      <!-- These values come from the decoded cookie in server.js. -->
      <p><strong>User ID:</strong> <%= user.id %></p>
      <p><strong>Role:</strong> <%= user.role %></p>

      <!-- This is a visible clue that role changes affect authorization. -->
      <% if (user.role === "admin") { %>
        <p class="admin-note">Admin-only inventory controls unlocked.</p>
      <% } else { %>
        <p>Regular user access only.</p>
      <% } %>
    </section>
  </main>
</body>
</html>
