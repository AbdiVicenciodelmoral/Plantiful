<!-- Tells the browser this document uses modern HTML5 -->
<!DOCTYPE html>

<!-- Starts the HTML document and sets the page language to English -->
<html lang="en">
<head>
  <!-- Sets the character encoding so text and symbols display correctly -->
  <meta charset="UTF-8" />

  <!-- Sets the title shown in the browser tab -->
  <title>Plantiful</title>

  <!-- Links this HTML page to an external CSS file for styling -->
  <!-- Because the path starts with "/", Express will look for this in the public folder -->
  <link rel="stylesheet" href="/style.css" />
</head>

<body>
  <!-- Navigation bar at the top of the page -->
  <nav class="navbar">
    <!-- Site logo / brand name shown on the left side of the navbar -->
    <div class="logo">Plantiful 🌿</div>

    <!-- Container for the navigation links shown on the right side -->
    <div class="nav-links">
      <!-- Link to the homepage route "/" -->
      <a href="/">Home</a>

      <!-- Placeholder link; "#" means it does not go to a real page yet -->
      <a href="#">Plants</a>

      <!-- Another placeholder link for a future care guides page -->
      <a href="#">Care Guides</a>

      <!-- EJS lets the page change depending on whether the server found a user. -->
      <% if (user) { %>
        <a href="/dashboard" class="login-btn">Dashboard</a>
      <% } else { %>
        <a href="/login" class="login-btn">Login</a>
      <% } %>
    </div>
  </nav>

  <!-- Hero section: the main intro area users see first -->
  <section class="hero">
    <!-- Wrapper div used to group the heading, paragraph, and search form -->
    <div>
      <!-- Main page heading -->
      <h1>Bring Your Space to Life</h1>

      <!-- Short description under the heading -->
      <p>Shop beautiful indoor plants, care tools, and beginner-friendly greenery.</p>

      <!-- Search form that sends a GET request to the "/search" route -->
      <!-- GET means the search term will appear in the URL, like /search?q=monstera -->
      <form class="search-box" action="/search" method="GET">
        <!-- Text input where the user types their search query -->
        <!-- name="q" is the key Express would read from req.query.q -->
        <input type="text" name="q" placeholder="Search for plants..." />

        <!-- Submit button sends the form data to the server -->
        <button type="submit">Search</button>
      </form>
    </div>
  </section>

  <!-- Section showing featured plant products -->
  <section class="featured">
    <!-- Section heading -->
    <h2>Featured Plants</h2>

    <!-- Container that groups all the plant cards together -->
    <div class="cards">
      <!-- One product card -->
      <div class="card">
        <!-- Plant name -->
        <h3>Monstera Deliciosa</h3>

        <!-- Short plant description -->
        <p>Bold tropical leaves for bright indoor spaces.</p>

        <!-- Product price -->
        <span>$24.99</span>
      </div>

      <!-- Second product card -->
      <div class="card">
        <h3>Snake Plant</h3>
        <p>Low-maintenance and perfect for beginners.</p>
        <span>$18.99</span>
      </div>

      <!-- Third product card -->
      <div class="card">
        <h3>Pothos</h3>
        <p>A fast-growing trailing plant for shelves and desks.</p>
        <span>$14.99</span>
      </div>
    </div>
  </section>

  <!-- About section explaining the purpose of the site -->
  <section class="about">
    <!-- Section heading -->
    <h2>Why Plantiful?</h2>

    <!-- Paragraph describing the value of the website -->
    <p>
      Plantiful helps new and experienced plant lovers find the right plants,
      learn care basics, and create healthier indoor spaces.
    </p>
  </section>
</body>
</html>
